
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  PENDING_VERIFICATION
  FLAGGED_FOR_MANUAL_REVIEW
  RECOMMENDED_FOR_APPROVAL
  APPROVED_BY_OFFICER
  REJECTED_BY_OFFICER
}

enum DocumentType {
  CASTE_CERTIFICATE
  INCOME_CERTIFICATE
  MARKSHEET
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
}


model User {
  id             String   @id @default(cuid())
  supabaseAuthId String   @unique
  email          String   @unique
  fullName       String
  role           UserRole @default(STUDENT)

  student   Student?
  decisions ApplicationDecision[] @relation("OfficerDecisions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Student {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber         String   @unique
  subCaste           String?
  annualIncome       Decimal? @db.Decimal(12, 2)
  academicPercentage Decimal? @db.Decimal(5, 2)
  courseName         String?
  instituteName      String?

  applications ScholarshipApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScholarshipScheme {
  id           String   @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean  @default(true)

  applications ScholarshipApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScholarshipApplication {
  id                String            @id @default(cuid())
  applicationNumber String            @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  schemeId String
  scheme   ScholarshipScheme @relation(fields: [schemeId], references: [id])

  status       ApplicationStatus @default(DRAFT)
  aiConfidence Decimal?          @db.Decimal(5, 2)
  aiRemarks    String?

  documents ApplicationDocument[]
  decisions ApplicationDecision[]

  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([schemeId])
}

model ApplicationDocument {
  id            String @id @default(cuid())
  applicationId String
  application   ScholarshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type        DocumentType
  storagePath String @unique
  originalName String
  mimeType    String
  sizeBytes   Int

  verificationStatus   VerificationStatus @default(PENDING)
  verificationRemarks String?

  createdAt DateTime @default(now())

  @@index([applicationId])
}

model ApplicationDecision {
  id            String @id @default(cuid())
  applicationId String
  application   ScholarshipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  officerId String
  officer   User @relation("OfficerDecisions", fields: [officerId], references: [id])

  status         ApplicationStatus
  officerRemarks String?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([officerId])
}
